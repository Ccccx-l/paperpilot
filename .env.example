# PaperPilot 模型服务配置示例
# ---------------------------------------------------------------
# 复制本文件为 .env 并填入你自己的配置：
#     cp .env.example .env
#
# .env 已被 .gitignore 忽略，不会进入版本库。请勿在本文件中填写真实密钥。
#
# 所有变量均可改用同名环境变量传入（环境变量优先于 .env）。
# 变量名与 src/mini_harness/config.py 的实际读取保持一致。
#
# 重要前提：模型服务必须支持 OpenAI 兼容的 function calling（tool_calls），
# 否则 Agent 无法调用 import_papers / search_papers / read_paper_page。
# ---------------------------------------------------------------


# ===== 形态一：本地 OpenAI 兼容模型服务（推荐隐私敏感场景）=====
# 适用于 vLLM、Ollama（OpenAI 兼容模式）、llama.cpp server 等。
# 下面以本地 vLLM 服务 Qwen3-VL-8B 为例（地址与模型名请按你的实际部署填写）。

MINI_HARNESS_PROVIDER=local
MINI_HARNESS_MODEL=qwen3-vl-8b
LOCAL_BASE_URL=http://127.0.0.1:8000/v1
# 本地服务通常不需要真实密钥；若服务端强制鉴权，填写占位值即可
LOCAL_API_KEY=EMPTY


# ===== 形态二：云端 OpenAI 兼容 API =====
# 适用于 OpenAI、DeepSeek、Moonshot、GLM 等提供 OpenAI 兼容接口的服务。
# 注意：使用云端模型时，论文标题、页码与原文片段会随工具结果发送给该服务。
#
# 下面以 DeepSeek 为例（其余服务同理，改 provider/base_url/model/密钥变量名）。
#
# MINI_HARNESS_PROVIDER=deepseek
# MINI_HARNESS_MODEL=deepseek-v4-flash
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# 使用 OpenAI 官方接口时：
# MINI_HARNESS_PROVIDER=openai
# MINI_HARNESS_MODEL=gpt-4.1
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ===== 可选项 =====
# 工作目录：决定索引数据库、会话文件与论文 PDF 的存放位置。
# 默认为启动命令时的当前目录；建议为每个研究项目固定一个工作目录。
# MINI_HARNESS_WORK_SPACE=/path/to/your/research-space

# 密钥变量名覆盖：若你的服务使用非标准密钥变量名，可在此指定
# MINI_HARNESS_API_KEY_ENV=MY_CUSTOM_KEY_VAR

# 直接指定密钥（优先级高于 {PROVIDER}_API_KEY）
# MINI_HARNESS_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
